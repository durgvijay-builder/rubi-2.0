# ==============================================================================
# R.U.B.I. 2.0 — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root and fill in your values.
# NEVER commit your actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Operational Mode:
# - `live`: Uses real external AI providers (Gnani, Gemini, ElevenLabs) when keys are configured.
# - `mock`: Uses built-in deterministically simulated adapters for offline/local development.
# - `hybrid`: Automatically uses live providers if configured, falling back to mock when unconfigured.
RUBI_MODE=mock

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rubi_dev?schema=public"

# ------------------------------------------------------------------------------
# 3. Speech-to-Text (STT) — Gnani Prisma
# ------------------------------------------------------------------------------
# Gnani Prisma converts spoken voice recordings (16kHz PCM WAV) into text.
GNANI_STT_API_KEY=""
GNANI_STT_URL="https://asr.gnani.ai/api/v1/transcribe"

# ------------------------------------------------------------------------------
# 4. Task Intelligence & Natural Language Extraction — Google Gemini
# ------------------------------------------------------------------------------
# Google Gemini powers task extraction, entity parsing, priority scoring, and intent routing.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ------------------------------------------------------------------------------
# 5. Text-to-Speech (TTS) — Gnani Timbre / ElevenLabs
# ------------------------------------------------------------------------------
# Active provider: `gnani` (default) or `elevenlabs`
RUBI_TTS_PROVIDER="gnani"

# Gnani Timbre TTS Settings
GNANI_TTS_API_KEY=""
GNANI_TTS_URL="https://tts.gnani.ai/api/v1/synthesize"

# ElevenLabs TTS Settings (Alternative TTS provider)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL_ID="eleven_monolingual_v1"

# ------------------------------------------------------------------------------
# 6. Web Push Notifications (VAPID)
# ------------------------------------------------------------------------------
# Generate keys with: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

