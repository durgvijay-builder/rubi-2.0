{
  "name": "@rubi/client",
  "version": "2.0.0",
  "private": true,
  "description": "Voice-First Web Frontend for R.U.B.I. 2.0 with React, Vite, Tailwind CSS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
